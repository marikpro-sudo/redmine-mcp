REDMINE_URL=https://redmine.example.com
# Personal key: My account -> API access key. Do not commit or paste into chat.
REDMINE_API_KEY=replace-with-your-personal-key
# Optional project identifier or numeric ID. Empty means all visible projects.
REDMINE_PROJECT=
REDMINE_TIME_ZONE=Asia/Almaty
# Optional persistent operation journal. Default: ~/.redmine-access/operations
# REDMINE_STATE_DIR=C:/Users/your-user/.redmine-access/operations
# Optional: exact custom field ID; otherwise match name "Соисполнители".
# REDMINE_COLLABORATOR_FIELD_ID=3
# For the optional loopback HTTP adapter only: independent random token >=32 chars.
# REDMINE_ACCESS_TOKEN=replace-with-a-random-local-token-at-least-32-characters
# REDMINE_ACCESS_PORT=3210
